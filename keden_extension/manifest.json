{
    "manifest_version": 3,
    "name": "Keden Assistant",
    "version": "1.1",
    "description": "Интеллектуальный помощник для автоматического заполнения таможенных деклараций на основе ИИ",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "alarms",
        "activeTab",
        "scripting",
        "tabs",
        "notifications"
    ],
    "host_permissions": [
        "https://keden.kgd.gov.kz/*",
        "https://pk.uchet.kz/*",
        "https://*.supabase.co/*",
        "https://raw.githubusercontent.com/*"
    ],
    "action": {
        "default_icon": "icon.png"
    },
    "icons": {
        "128": "icon.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://keden.kgd.gov.kz/*"
            ],
            "js": [
                "content/admin_auth.js",
                "content/dictionaries.js",
                "content/token_utils.js",
                "content/mappers.js",
                "content/api.js",
                "content/enrichment.js",
                "content/keep_alive.js",
                "content/main.js"
            ]
        }
    ]
}